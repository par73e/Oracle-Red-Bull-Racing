FoamFile {version 2.0; format ascii; class dictionary; object postProcessDict;}
 slices
 {
  type surfaces;
  libs ("libsampling.so");
  writeControl writeTime;
  surfaceFormat vtk;
  fields (p U);
  interpolationScheme cellPoint;
  surfaces
  {
   centerPlane {type cutPlane; point (0 0 0); normal (0 1 0); interpolate true;}
   frontWheelPlane {type cutPlane; point (0 -0.796 0); normal (0 1 0); interpolate true;}
   horizontalPlane {type cutPlane; point (0 0 0.30); normal (0 0 1); interpolate true;}
  }
 }
